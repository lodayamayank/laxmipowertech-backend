PORT=5002
NODE_ENV=development

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/laxmiMaterial?retryWrites=true&w=majority

BASE_URL=http://localhost:5002
FRONTEND_URL=http://localhost:5173

UPLOAD_DIR=uploads

API_KEY=<your-secure-api-key>
JWT_SECRET=<your-secure-jwt-secret>

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Cloudinary is required for material/intent image and challan uploads
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# ---- Cloudflare R2 (project documents) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
# Optional tuning (defaults shown)
# DOCUMENT_MAX_SIZE_MB=100
# DOCUMENT_UPLOAD_URL_TTL=600
# DOCUMENT_DOWNLOAD_URL_TTL=300
# R2_SIGN_CONTENT_LENGTH=true
