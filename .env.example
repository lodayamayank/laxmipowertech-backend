PORT=5002
NODE_ENV=development

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/laxmiMaterial?retryWrites=true&w=majority

BASE_URL=http://localhost:5002
PUBLIC_BASE_URL=http://localhost:5002
FRONTEND_URL=http://localhost:5173

UPLOAD_DIR=uploads

API_KEY=<your-secure-api-key>
JWT_SECRET=<your-secure-jwt-secret>

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Legacy Cloudinary settings retained; new uploads use local/NAS disk storage
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# Retained from the earlier approach; unused by the uploads/ disk-storage flow
STORAGE_ROOT=/mnt/nas/attendance
TZ=Asia/Kolkata
